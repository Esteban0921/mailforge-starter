{
  "name": "mailforge",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || exit 0",
    "db:generate": "pnpm --filter @mailforge/database generate",
    "db:migrate": "pnpm --filter @mailforge/database migrate:dev",
    "db:studio": "pnpm --filter @mailforge/database studio"
  },
  "devDependencies": {
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.35.0"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  }
}
