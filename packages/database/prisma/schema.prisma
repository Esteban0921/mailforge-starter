generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Fase 1 - Multi-tenant base (docs/DATA_MODEL.md)
// Migracion pendiente hasta tener Docker (TASK-0015/0016):
// el schema ya valida y el cliente se genera sin BD.
// ============================================================

enum UserRole {
  owner
  admin
  member
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships OrganizationMember[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     OrganizationMember[]
  audiences   Audience[]
  subscribers Subscriber[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           UserRole @default(member)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

// ============================================================
// Fase 2 - Audiencias y suscriptores (docs/DATA_MODEL.md)
// Diseño de opt-in (TASK-0055) y segmentación (TASK-0057) ya
// decidido; CRUD/endpoints reales siguen bloqueados por TASK-0015
// (sin Docker no hay Postgres contra el que probarlos de verdad).
// ============================================================

enum SubscriberStatus {
  pending
  subscribed
  unsubscribed
  bounced
  complained
}

model Audience {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscribers  AudienceSubscriber[]
  segments     Segment[]

  @@index([organizationId])
}

model Subscriber {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  firstName      String?
  lastName       String?
  status         SubscriberStatus @default(pending)
  /// Solo mientras status = pending; se limpia al confirmar (TASK-0055).
  confirmToken   String?
  confirmedAt    DateTime?
  consentAt      DateTime?
  /// Origen del consentimiento, p. ej. "csv_import:lista-2026" o "signup_form".
  consentSource  String?
  customFields   Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audiences    AudienceSubscriber[]

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@index([confirmToken])
}

model AudienceSubscriber {
  audienceId   String
  subscriberId String
  subscribedAt DateTime @default(now())

  audience   Audience   @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@id([audienceId, subscriberId])
  @@index([subscriberId])
}

model Segment {
  id             String   @id @default(cuid())
  organizationId String
  audienceId     String
  name           String
  /// DSL de reglas (campo/operador/valor, AND) — nunca SQL libre. Ver DATA_MODEL.md.
  rules          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  audience Audience @relation(fields: [audienceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([audienceId])
}
