{
  "name": "@mailforge/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm run build && concurrently -k -n tsc,node -c cyan,magenta \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch --enable-source-maps dist/main.js\"",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@mailforge/shared": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6",
    "helmet": "^8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "^1.11.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.1.2",
    "supertest": "^7.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.35.0",
    "unplugin-swc": "^1.5.2",
    "vitest": "^3.2.0"
  }
}
