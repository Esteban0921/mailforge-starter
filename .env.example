# Database
DATABASE_URL="postgresql://mailforge:mailforge@localhost:5432/mailforge?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# API
API_PORT=3001
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-seguro"
JWT_EXPIRES_IN="7d"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Email (desarrollo - Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MailForge <noreply@mailforge.local>"

# App
NODE_ENV=development


# Directorio de salida del build de Next (opcional, por defecto .next).
# Escotilla para cuando un `next dev` activo pisa el build que prueban los
# E2E. Ojo: al cambiarlo, Next reescribe next-env.d.ts y tsconfig.json
# apuntando al nuevo directorio; revierte esos dos ficheros al terminar.
# NEXT_DIST_DIR=".next"
